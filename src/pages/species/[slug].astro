---
import Layout from "../../layouts/Layout.astro";
import Disclaimer from "../../components/Disclaimer.astro";
import { GermanyMap } from "../../components/GermanyMap";
import { SpeciesStateList } from "../../components/SpeciesStateList";
import {
  availableSpecies,
  getSpeciesDetail,
  speciesMatrix,
} from "../../lib/data";
import { seasonCalendarText } from "../../lib/format";
import { TAGS } from "../../lib/tags";
import { href } from "../../lib/paths";

export function getStaticPaths() {
  return availableSpecies().map((s) => ({
    params: { slug: s.key },
    props: { key: s.key },
  }));
}

const { key } = Astro.props;
const data = getSpeciesDetail(key);
if (!data) throw new Error(`No species data for '${key}'`);
const tagLabels = TAGS.filter((t) => data.tags.includes(t.key)).map(
  (t) => t.label,
);
---

<Layout title={`${data.speciesLabel} – Jagdzeiten – Jagdampel`}>
  <main class="container mx-auto max-w-2xl p-4">
    <a href={href()} class="text-sm text-gray-500 hover:underline"
      >← Startseite</a
    >
    <h1 class="mt-1 text-3xl font-bold text-jagd-forest">
      {data.speciesLabel}
    </h1>
    <p class="mt-1 text-gray-600">
      In welchen Bundesländern ist jetzt Jagdzeit?
    </p>
    {
      tagLabels.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-2">
          {tagLabels.map((label) => (
            <li class="rounded-full bg-gray-100 px-2.5 py-0.5 text-sm text-gray-600">
              {label}
            </li>
          ))}
        </ul>
      )
    }

    <section class="mt-6">
      <GermanyMap
        client:only="react"
        matrix={speciesMatrix(key)}
        speciesKey={key}
      />
    </section>

    <div class="mt-6">
      <SpeciesStateList
        client:only="react"
        states={data.states}
        speciesLabel={data.speciesLabel}
      />
      <noscript>
        <p class="mb-4 text-sm text-gray-600">
          Für den Live-Ampelstatus bitte JavaScript aktivieren. Unten die
          erfassten Jagdzeiten je Bundesland:
        </p>
        <ul class="divide-y divide-gray-200">
          {
            data.states.map((state) => (
              <li class="py-2">
                <a
                  href={href(`state/${state.code.toLowerCase()}`)}
                  class="font-semibold text-jagd-forest hover:underline"
                >
                  {state.name}
                </a>
                <ul class="mt-1 pl-1 text-sm text-gray-600">
                  {state.entries.map((entry) => (
                    <li>
                      {entry.classLabel && (
                        <span class="font-medium">{entry.classLabel}: </span>
                      )}
                      {seasonCalendarText(entry.season)}
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </noscript>
    </div>

    <Disclaimer />
  </main>
</Layout>
