---
import Layout from "../layouts/Layout.astro";
import Disclaimer from "../components/Disclaimer.astro";
import { SeasonMatrix } from "../components/SeasonMatrix";
import { buildMatrix } from "../lib/data";
import { href } from "../lib/paths";

const matrix = buildMatrix();
---

<Layout title="Übersicht – Jagdzeiten aller Länder – Jagdampel">
  <main class="container mx-auto max-w-5xl p-4">
    <a href={href()} class="text-sm text-gray-500 hover:underline"
      >← Startseite</a
    >
    <h1 class="mt-1 text-3xl font-bold text-jagd-forest">Übersicht</h1>
    <p class="mt-1 text-gray-600">
      Jagd- und Schonzeiten aller erfassten Bundesländer auf einen Blick. Monat
      wählen, Spalte = Bundesland.
    </p>

    <div class="mt-6">
      <SeasonMatrix client:only="react" matrix={matrix} />
      <noscript>
        <p class="text-sm text-gray-600">
          Die Übersichtstabelle benötigt JavaScript. Einzelne Bundesländer gibt
          es auch ohne: <a class="underline" href={href()}>zur Länderauswahl</a
          >.
        </p>
      </noscript>
    </div>

    <Disclaimer />
  </main>
</Layout>
