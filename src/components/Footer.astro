---
import { href } from "../lib/paths";

const githubUrl = "https://github.com/CaptainStandby/jagdampel";
const linkClass = "text-jagd-forest underline hover:no-underline";
---

<footer class="border-t border-gray-200 text-sm text-gray-500">
  <div class="container mx-auto max-w-5xl space-y-2 p-4">
    <p>
      Jagdampel ist Open Source. Daten veraltet oder fehlerhaft?{" "}
      <a class={linkClass} href={githubUrl} rel="noopener" target="_blank">
        Auf GitHub beitragen
      </a>.
    </p>
    <p>
      © Jagdampel · Orientierungshilfe, keine Rechtsberatung ·{" "}
      <a class={linkClass} href={href("impressum")}>Impressum</a> ·{" "}
      <a class={linkClass} href={href("datenschutz")}>Datenschutz</a>
    </p>
  </div>
</footer>
