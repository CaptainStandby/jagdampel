---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jagdzeiten in Deutschland - sofort sehen, was gerade frei ist." />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 min-h-screen">
    <slot />
  </body>
</html>
